# Runtime trust domain
GHIMS_RUNTIME_MODE=DEMO
NEXT_PUBLIC_GHIMS_RUNTIME_MODE=DEMO

# Dedicated Firebase projects. DEMO/STAGING/PRODUCTION must be different.
GHIMS_FIREBASE_PROJECT_ID_DEMO=
GHIMS_FIREBASE_PROJECT_ID_TEST=
GHIMS_FIREBASE_PROJECT_ID_STAGING=
GHIMS_FIREBASE_PROJECT_ID_PRODUCTION=
NEXT_PUBLIC_GHIMS_FIREBASE_PROJECT_ID_DEMO=
NEXT_PUBLIC_GHIMS_FIREBASE_PROJECT_ID_TEST=
NEXT_PUBLIC_GHIMS_FIREBASE_PROJECT_ID_STAGING=
NEXT_PUBLIC_GHIMS_FIREBASE_PROJECT_ID_PRODUCTION=

# Active environment Firebase configuration
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIRESTORE_DATABASE_ID=(default)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIRESTORE_DATABASE_ID=(default)

# AI is opt-in; credentials alone do not activate it.
GHIMS_INTEGRATION_AI_STATE=DISABLED
GHIMS_AI_PROVIDER=
GHIMS_AI_MODEL=
GEMINI_API_KEY=

# External integration activation
GHIMS_INTEGRATION_HL7_STATE=DISABLED
GHIMS_HL7_INGEST_API_KEY=
GHIMS_HL7_ALLOWED_SENDING_APPS=
GHIMS_HL7_RETAIN_RAW=false
GHIMS_INTEGRATION_FHIR_R4_STATE=DISABLED
GHIMS_INTEGRATION_DICOMWEB_STATE=DISABLED
GHIMS_INTEGRATION_DEVICE_TELEMETRY_STATE=DISABLED
GHIMS_INTEGRATION_EDI_X12_STATE=DISABLED

# Backup / restore operations
GHIMS_BACKUP_BUCKET=
GHIMS_BACKUP_DRY_RUN=true
GHIMS_RESTORE_SOURCE=
GHIMS_RESTORE_CONFIRM_PROJECT=
GHIMS_ALLOW_PRODUCTION_RESTORE=false
GHIMS_RESTORE_DRY_RUN=true

# Isolated projection recovery rehearsal
# Never enable this against the production runtime/project.
GHIMS_PROJECTION_REBUILD_TENANT=
GHIMS_PROJECTION_REBUILD_CONFIRM_TENANT=
GHIMS_ALLOW_DESTRUCTIVE_PROJECTION_REBUILD=false

# Identity/bootstrap operations
# Bootstrap is an explicit operator action, never an application startup behavior.
GHIMS_BOOTSTRAP_ADMIN_EMAIL=
GHIMS_BOOTSTRAP_ADMIN_TENANT=
GHIMS_BOOTSTRAP_ADMIN_DISPLAY_NAME=
GHIMS_BOOTSTRAP_CONFIRM_PROJECT=
GHIMS_ALLOW_ADMIN_BOOTSTRAP=false
GHIMS_ALLOW_PRODUCTION_ADMIN_BOOTSTRAP=false

# DEMO-only Firebase identities
GHIMS_DEMO_TENANT_ID=central-metro-hospital
GHIMS_DEMO_BOOTSTRAP_PASSWORD=
