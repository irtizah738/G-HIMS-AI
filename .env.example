# Runtime classification
GHIMS_RUNTIME_MODE=DEMO

# Firebase - use a different project for each deployed environment.
FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIRESTORE_DATABASE_ID=

# AI is disabled unless state is explicitly LIVE and a provider is named.
GHIMS_INTEGRATION_AI_STATE=DISABLED
GHIMS_AI_PROVIDER=
GHIMS_AI_MODEL=
GEMINI_API_KEY=

# External integrations are fail-closed by default.
GHIMS_INTEGRATION_HL7_STATE=DISABLED
GHIMS_INTEGRATION_FHIR_R4_STATE=DISABLED
GHIMS_INTEGRATION_DICOMWEB_STATE=DISABLED
GHIMS_INTEGRATION_DEVICE_TELEMETRY_STATE=DISABLED
GHIMS_INTEGRATION_EDI_X12_STATE=DISABLED

# HL7 integration identity / source restrictions.
GHIMS_HL7_INGEST_API_KEY=
GHIMS_HL7_ALLOWED_SENDING_APPS=
GHIMS_HL7_RETAIN_RAW=false

# Production backup / recovery readiness.
# These values are configuration and targets, not proof that a restore succeeded.
GHIMS_BACKUP_PROJECT_ID=
GHIMS_BACKUP_BUCKET=
GHIMS_BACKUP_RETENTION_DAYS=
GHIMS_RPO_TARGET_MINUTES=
GHIMS_RTO_TARGET_MINUTES=
GHIMS_LAST_RESTORE_DRILL_AT=

# External operations destination identifier (for example an on-call/alert route name).
# Do not put webhook secrets in this variable.
GHIMS_ALERTING_DESTINATION=
