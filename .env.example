# Runtime trust domain
GHIMS_RUNTIME_MODE=DEMO
NEXT_PUBLIC_GHIMS_RUNTIME_MODE=DEMO

# Dedicated Firebase projects. DEMO/STAGING/PRODUCTION must be different.
GHIMS_FIREBASE_PROJECT_ID_DEMO=
GHIMS_FIREBASE_PROJECT_ID_TEST=
GHIMS_FIREBASE_PROJECT_ID_STAGING=
GHIMS_FIREBASE_PROJECT_ID_PRODUCTION=
NEXT_PUBLIC_GHIMS_FIREBASE_PROJECT_ID_DEMO=
NEXT_PUBLIC_GHIMS_FIREBASE_PROJECT_ID_TEST=
NEXT_PUBLIC_GHIMS_FIREBASE_PROJECT_ID_STAGING=
NEXT_PUBLIC_GHIMS_FIREBASE_PROJECT_ID_PRODUCTION=

# Active environment Firebase configuration
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIRESTORE_DATABASE_ID=(default)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIRESTORE_DATABASE_ID=(default)

# AI is opt-in; credentials alone do not activate it.
GHIMS_INTEGRATION_AI_STATE=DISABLED
GHIMS_AI_PROVIDER=
GHIMS_AI_MODEL=
GEMINI_API_KEY=

# External integration activation
GHIMS_INTEGRATION_HL7_STATE=DISABLED
GHIMS_HL7_INGEST_API_KEY=
GHIMS_HL7_ALLOWED_SENDING_APPS=
GHIMS_HL7_RETAIN_RAW=false
GHIMS_INTEGRATION_FHIR_R4_STATE=DISABLED
GHIMS_INTEGRATION_DICOMWEB_STATE=DISABLED
GHIMS_INTEGRATION_DEVICE_TELEMETRY_STATE=DISABLED
GHIMS_INTEGRATION_EDI_X12_STATE=DISABLED

# Backup / restore operations
GHIMS_BACKUP_BUCKET=
GHIMS_BACKUP_DRY_RUN=true
GHIMS_RESTORE_SOURCE=
GHIMS_RESTORE_CONFIRM_PROJECT=
GHIMS_ALLOW_PRODUCTION_RESTORE=false
GHIMS_RESTORE_DRY_RUN=true

# Isolated projection recovery rehearsal
# Never enable this against the production runtime/project.
GHIMS_PROJECTION_REBUILD_TENANT=
GHIMS_PROJECTION_REBUILD_CONFIRM_TENANT=
GHIMS_ALLOW_DESTRUCTIVE_PROJECTION_REBUILD=false

# Identity/bootstrap operations
# Bootstrap is an explicit operator action, never an application startup behavior.
GHIMS_BOOTSTRAP_ADMIN_EMAIL=
GHIMS_BOOTSTRAP_ADMIN_TENANT=
GHIMS_BOOTSTRAP_ADMIN_DISPLAY_NAME=
GHIMS_BOOTSTRAP_CONFIRM_PROJECT=
GHIMS_ALLOW_ADMIN_BOOTSTRAP=false
GHIMS_ALLOW_PRODUCTION_ADMIN_BOOTSTRAP=false

# DEMO-only Firebase identities
GHIMS_DEMO_TENANT_ID=central-metro-hospital
GHIMS_DEMO_BOOTSTRAP_PASSWORD=


# Certified ambulance / device telemetry ingestion
# Set DEVICE_TELEMETRY state to LIVE only after physical-device qualification.
GHIMS_INTEGRATION_DEVICE_TELEMETRY_STATE=DISABLED
GHIMS_DEVICE_TELEMETRY_INGEST_API_KEY=


# Wave 4 external interoperability
# HL7 v2 / MLLP
GHIMS_INTEGRATION_HL7_STATE=DISABLED
GHIMS_HL7_INGEST_API_KEY=
GHIMS_HL7_ALLOWED_SENDING_APPS=
GHIMS_HL7_MLLP_HOST=0.0.0.0
GHIMS_HL7_MLLP_PORT=2575
GHIMS_HL7_INTERNAL_INGEST_URL=http://127.0.0.1:3000/api/interop/hl7/receive
GHIMS_HL7_SOURCE_ROUTES_JSON=[]
GHIMS_HL7_MLLP_SOURCE_ROUTES_JSON=[]
GHIMS_HL7_MLLP_TLS_ENABLED=false
GHIMS_HL7_MLLP_TLS_CERT_PATH=
GHIMS_HL7_MLLP_TLS_KEY_PATH=
GHIMS_HL7_MLLP_TLS_CA_PATH=

# FHIR R4
GHIMS_INTEGRATION_FHIR_R4_STATE=DISABLED
GHIMS_FHIR_BASE_URL=
GHIMS_FHIR_ACCESS_TOKEN=
GHIMS_FHIR_APPROVED_RESOURCES=Patient,Encounter,Observation,DiagnosticReport,Condition,AllergyIntolerance,MedicationRequest,MedicationAdministration,Procedure,CarePlan,DocumentReference
GHIMS_FHIR_WRITABLE_RESOURCES=Observation,DiagnosticReport,DocumentReference

# DICOMweb / PACS
GHIMS_INTEGRATION_DICOMWEB_STATE=DISABLED
GHIMS_DICOMWEB_BASE_URL=
GHIMS_DICOMWEB_AUTH_TOKEN=
GHIMS_DICOMWEB_ALLOWED_HOSTS=

# EDI X12 — intentionally disabled unless an external clearinghouse program is started
GHIMS_INTEGRATION_EDI_X12_STATE=DISABLED
GHIMS_EDI_PROGRAM_ENABLED=false
GHIMS_EDI_EXTERNAL_CONFORMANCE_QUALIFIED=false
GHIMS_EDI_CLEARINGHOUSE_BASE_URL=
GHIMS_EDI_CLEARINGHOUSE_API_KEY=
GHIMS_EDI_835_INGEST_API_KEY=
GHIMS_EDI_RETAIN_RAW=false


# Wave 5 enterprise hardening
GHIMS_WAVE5_BASE_URL=
GHIMS_WAVE5_TENANT_ID=
GHIMS_WAVE5_LOAD_EMAIL=
GHIMS_WAVE5_LOAD_PASSWORD=
GHIMS_WAVE5_LOAD_REQUESTS=100
GHIMS_WAVE5_LOAD_CONCURRENCY=10
GHIMS_WAVE5_LOAD_P95_LIMIT_MS=3000
GHIMS_WAVE5_LOAD_MAX_ERROR_RATE=0.01
GHIMS_WAVE5_LOAD_TIMEOUT_MS=15000
GHIMS_WAVE5_BYPASS_HEADER_NAME=
GHIMS_WAVE5_BYPASS_HEADER_VALUE=
GHIMS_WAVE5_EVIDENCE_DIR=artifacts/wave5
GHIMS_WAVE5_REQUIRE_COMPLETE=false

# Optional protected STAGING browser qualification
GHIMS_STAGING_BYPASS_HEADER_NAME=
GHIMS_STAGING_BYPASS_HEADER_VALUE=

# Deployment-specific retention/governance. Required by the Wave 5 governance
# preflight in deployed STAGING/PRODUCTION. Durations/policies must be approved
# for the actual institution and jurisdiction; do not copy placeholder values.
GHIMS_RETENTION_OPERATIONAL_DAYS=
GHIMS_RETENTION_AUDIT_POLICY=
GHIMS_RETENTION_CLINICAL_AUTHORITY_POLICY=
GHIMS_RETENTION_FINANCIAL_AUTHORITY_POLICY=
GHIMS_RETENTION_INTEGRATION_RAW_POLICY=

# Isolated recovery only. Never enable in production.
GHIMS_PROJECTION_REBUILD_INJECT_FAILURE=

# TELEHEALTH WebRTC — server-only, session-scoped TURN credentials
# Use institution-managed STUN/TURN infrastructure with an authenticated coturn
# REST shared secret (use secure hosting secrets, NEVER NEXT_PUBLIC_ variables).
# Do not put TURN usernames or passwords in public build-time configuration.
# The browser obtains 1-hour credentials from /api/telehealth/ice-config
# after clinician/active-patient-room authorization.
GHIMS_WEBRTC_STUN_URLS_JSON=[]
GHIMS_WEBRTC_TURN_URLS_JSON=[]
GHIMS_WEBRTC_TURN_REST_SECRET=
