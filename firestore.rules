rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function tenantClaimMatches(tenantId) {
      return signedIn() && (
        request.auth.token.tenantId == tenantId ||
        (
          request.auth.token.accessibleTenants is list &&
          tenantId in request.auth.token.accessibleTenants
        )
      );
    }

    function self(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function membershipPath(tenantId) {
      return /databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid);
    }

    function hasActiveMembership(tenantId) {
      return tenantClaimMatches(tenantId) &&
        exists(membershipPath(tenantId)) &&
        get(membershipPath(tenantId)).data.status == 'ACTIVE';
    }

    function membershipData(tenantId) {
      return get(membershipPath(tenantId)).data;
    }

    function memberRoles(tenantId) {
      return membershipData(tenantId).get('roles', []);
    }

    function memberLegacyRole(tenantId) {
      return membershipData(tenantId).get('role', '');
    }

    function hasAnyRole(tenantId, allowedRoles) {
      return hasActiveMembership(tenantId) && (
        memberRoles(tenantId).hasAny(allowedRoles) ||
        memberLegacyRole(tenantId) in allowedRoles
      );
    }

    function canReadClinical(tenantId) {
      return hasAnyRole(tenantId, [
        'administrator',
        'doctor',
        'nurse',
        'receptionist',
        'pharmacist',
        'lab_tech',
        'radiologist',
        'surgeon'
      ]);
    }

    function canReadOpdScheduling(tenantId) {
      return hasAnyRole(tenantId, [
        'administrator',
        'receptionist',
        'registrar',
        'call_center',
        'doctor',
        'consultant',
        'nurse',
        'SYSTEM_ADMIN',
        'ADMINISTRATOR',
        'RECEPTIONIST',
        'REGISTRAR',
        'CALL_CENTER',
        'DOCTOR',
        'CONSULTANT',
        'NURSE'
      ]);
    }

    function canReadFinance(tenantId) {
      return hasAnyRole(tenantId, [
        'administrator',
        'billing_clerk',
        'billing_staff',
        'accounts_payable',
        'accountant',
        'finance_manager',
        'treasury_manager',
        'auditor',
        'tax_accountant',
        'budget_manager',
        'fixed_asset_accountant',
        'billing_admin',
        'ACCOUNTS_PAYABLE',
        'ACCOUNTANT',
        'FINANCE_MANAGER',
        'TREASURY_MANAGER',
        'AUDITOR',
        'TAX_ACCOUNTANT',
        'BUDGET_MANAGER',
        'FIXED_ASSET_ACCOUNTANT',
        'BILLING_ADMIN',
        'SYSTEM_ADMIN',
        'ADMINISTRATOR'
      ]);
    }

    function canReadScm(tenantId) {
      return hasAnyRole(tenantId, [
        'administrator',
        'pharmacist',
        'store_keeper',
        'inventory_officer',
        'scm_manager',
        'PHARMACIST',
        'STORE_KEEPER',
        'INVENTORY_OFFICER',
        'SCM_MANAGER',
        'SYSTEM_ADMIN',
        'ADMINISTRATOR'
      ]);
    }

    function canReadFacilities(tenantId) {
      return hasAnyRole(tenantId, [
        'administrator',
        'facilities_admin',
        'biomedical_engineer',
        'hospital_executive',
        'housekeeping',
        'FACILITIES_ADMIN',
        'BIOMEDICAL_ENGINEER',
        'HOSPITAL_EXECUTIVE',
        'HOUSEKEEPING',
        'SYSTEM_ADMIN',
        'ADMINISTRATOR'
      ]);
    }

    function canReadAudit(tenantId) {
      return hasAnyRole(tenantId, [
        'administrator',
        'ADMINISTRATOR',
        'SYSTEM_ADMIN',
        'system_admin',
        'auditor',
        'AUDITOR'
      ]);
    }

    // Default deny. Firebase Admin/server SDK bypasses these rules and is the
    // authoritative mutation path.
    match /{document=**} {
      allow read, write: if false;
    }

    // Minimal authenticated profile read. Authorization data itself is server managed.
    match /user_profiles/{userId} {
      allow get: if self(userId);
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Legacy root collections remain read-only while the UI is migrated to
    // tenant-scoped projections. No browser may mutate hospital state here.
    match /patients/{id} {
      allow read, write: if false;
    }
    match /beds/{id} {
      allow read, write: if false;
    }
    match /billingMismatches/{id} {
      allow read, write: if false;
    }
    match /opdQueue/{id} {
      allow read, write: if false;
    }
    match /staff/{id} {
      allow read, write: if false;
    }
    match /telehealth_sessions/{id} {
      allow read, write: if false;
    }
    match /telehealthAppointments/{id} {
      allow read, write: if false;
    }
    match /auditLogs/{id} {
      allow read, write: if false;
    }
    match /hl7Messages/{id} {
      allow read, write: if false;
    }

    // Tenant metadata is visible only inside an active tenant membership.
    // Tenant and membership authority are server-managed; browser clients cannot
    // self-provision, widen roles, or browse another tenant's membership graph.
    match /tenants/{tenantId} {
      allow get: if hasActiveMembership(tenantId);
      allow list, create, update, delete: if false;

      // Users may read only their own active membership. Provisioning and role
      // changes must occur through trusted server/Admin SDK paths.
      match /users/{userId} {
        allow get: if hasActiveMembership(tenantId) && self(userId);
        allow list, create, update, delete: if false;
      }

      // Sessions and devices are security state and are never browser writable.
      match /sessions/{sessionId} {
        allow read, write: if false;
      }
      match /devices/{deviceId} {
        allow read, write: if false;
      }

      // Clinical read models. Mutations must go through authenticated server commands.
      match /patients/{patientId} {
        allow read: if canReadClinical(tenantId);
        allow write: if false;

        match /timeline/{eventId} {
          allow read: if canReadClinical(tenantId);
          allow write: if false;
        }
      }

      match /beds/{bedId} {
        allow read: if canReadClinical(tenantId) || canReadFacilities(tenantId) || canReadAudit(tenantId);
        allow write: if false;
      }

      match /surgicalCases/{caseId} {
        allow read: if canReadClinical(tenantId);
        allow write: if false;
      }

      match /orRoomSchedules/{roomId} {
        allow read: if canReadClinical(tenantId) || canReadFacilities(tenantId);
        allow write: if false;
      }

      match /telehealthSessions/{sessionId} {
        allow read: if canReadClinical(tenantId);
        allow write: if false;
      }

      match /mpi_registry/{mpiKey} {
        allow read: if canReadClinical(tenantId);
        allow write: if false;
      }

      match /encounters/{encounterId} {
        allow read: if canReadClinical(tenantId);
        allow write: if false;

        match /{nested=**} {
          allow read: if canReadClinical(tenantId);
          allow write: if false;
        }
      }

      match /opd_queue/{tokenId} {
        allow read: if canReadClinical(tenantId);
        allow write: if false;
      }

      // OPD scheduling read models are client-readable only to scheduling/
      // clinical roles. Slot locks are concurrency-control internals and never
      // exposed directly; all scheduling mutations execute through commands.
      match /opdAppointments/{appointmentId} {
        allow read: if canReadOpdScheduling(tenantId);
        allow write: if false;
      }
      match /opdWaitlist/{waitlistId} {
        allow read: if canReadOpdScheduling(tenantId);
        allow write: if false;
      }
      match /opdAppointmentSlots/{slotId} {
        allow read, write: if false;
      }

      match /diagnostic_orders/{orderId} {
        allow read: if canReadClinical(tenantId);
        allow write: if false;
      }

      match /orders/{orderId} {
        allow read: if canReadClinical(tenantId);
        allow write: if false;
      }

      match /prescriptions/{prescriptionId} {
        allow read: if canReadClinical(tenantId);
        allow write: if false;
      }

      match /labResults/{resultId} {
        allow read: if canReadClinical(tenantId);
        allow write: if false;
      }

      match /radiologyResults/{resultId} {
        allow read: if canReadClinical(tenantId);
        allow write: if false;
      }

      match /clinicalQueues/{queueId} {
        allow read: if canReadClinical(tenantId);
        allow write: if false;
      }

      match /timelineProjections/{projectionId} {
        allow read: if canReadClinical(tenantId);
        allow write: if false;
      }

      match /generalLedgerProjections/{projectionId} {
        allow read: if canReadClinical(tenantId);
        allow write: if false;
      }

      // Patient 360 contains assembled PHI and must only be read through the
      // authenticated server API where full-chart authorization is enforced.
      match /patient360Projections/{patientId} {
        allow read, write: if false;
      }
      match /patient360Timeline/{timelineItemId} {
        allow read, write: if false;
      }
      match /patient360ProjectionCheckpoints/{eventId} {
        allow read, write: if false;
      }

      // Clinical Intelligence is derived PHI. Clients consume bounded projections
      // only through authenticated server APIs / encrypted offline hydration.
      match /dischargeReadinessProjections/{encounterId} {
        allow read, write: if false;
      }
      match /dischargeReadinessCheckpoints/{eventId} {
        allow read, write: if false;
      }
      match /clinicalIntelligenceEvaluations/{evaluationId} {
        allow read, write: if false;
      }
      match /deteriorationProjections/{encounterId} {
        allow read, write: if false;
      }
      match /deteriorationCheckpoints/{eventId} {
        allow read, write: if false;
      }
      match /clinicalDeteriorationEvaluations/{evaluationId} {
        allow read, write: if false;
      }
      match /dischargeReadinessReviews/{reviewId} {
        allow read, write: if false;
      }
      match /medicationSafetyProjections/{patientId} {
        allow read, write: if false;
      }
      match /medicationSafetyCheckpoints/{eventId} {
        allow read, write: if false;
      }

      match /clinicalIntelligenceEvidenceSnapshots/{snapshotId} {
        allow read, write: if false;
      }

      match /clinicalLongitudinalSummaries/{summaryId} {
        allow read, write: if false;
      }

      match /clinicalEncounterPreparationBriefs/{briefId} {
        allow read, write: if false;
      }

      match /clinicalTrendIntelligence/{artifactId} {
        allow read, write: if false;
      }

      match /medicationReconciliationCopilotArtifacts/{artifactId} {
        allow read, write: if false;
      }

      // CI-10F governed clinical drafts and immutable revisions are derived PHI.
      // They are readable/mutable only through authenticated server APIs and commands.
      match /clinicalDrafts/{draftId} {
        allow read, write: if false;
      }
      match /clinicalDraftRevisions/{revisionId} {
        allow read, write: if false;
      }

      // CI-10H safety evaluations are immutable server-owned release/runtime evidence.
      match /clinicalIntelligenceSafetyEvaluations/{evaluationId} {
        allow read, write: if false;
      }

      match /consultantReviewCheckpoints/{checkpointId} {
        allow read, write: if false;
      }
      match /consultantAttentionCheckpoints/{eventId} {
        allow read, write: if false;
      }
      match /clinicalOpenItems/{openItemId} {
        allow read, write: if false;
      }
      match /clinicalEscalations/{escalationId} {
        allow read, write: if false;
      }
      match /consultationRequests/{consultationId} {
        allow read, write: if false;
      }
      match /clinicalHandoffs/{handoffId} {
        allow read, write: if false;
      }

      match /diagnosticResultAcknowledgements/{acknowledgementId} {
        allow read, write: if false;
      }

      // Projection checkpoints are internal idempotency state and server-only.
      match /projectionCheckpoints/{eventId} {
        allow read, write: if false;
      }

      // Financial read models can be read only within tenant scope. All postings,
      // adjustments, reversals and idempotency records are server-only writes.
      match /financeTrialBalanceSnapshots/{id} {
        allow read: if canReadFinance(tenantId);
        allow write: if false;
      }
      match /financeRevenueRecognitions/{id} {
        allow read: if canReadFinance(tenantId);
        allow write: if false;
      }
      match /financeArAdjustments/{id} {
        allow read: if canReadFinance(tenantId);
        allow write: if false;
      }
      match /financeArReceipts/{id} {
        allow read: if canReadFinance(tenantId);
        allow write: if false;
      }
      match /financeArAgingSnapshots/{id} {
        allow read: if canReadFinance(tenantId);
        allow write: if false;
      }
      match /treasuryAccounts/{id} {
        allow read: if canReadFinance(tenantId);
        allow write: if false;
      }
      match /cashRegisterShifts/{id} {
        allow read: if canReadFinance(tenantId);
        allow write: if false;
      }
      match /financeTreasuryTransfers/{id} {
        allow read: if canReadFinance(tenantId);
        allow write: if false;
      }
      match /financeBankReconciliations/{id} {
        allow read: if canReadFinance(tenantId);
        allow write: if false;
      }
      match /financeApAgingSnapshots/{id} {
        allow read: if canReadFinance(tenantId);
        allow write: if false;
      }
      match /financeSupplierCredits/{id} {
        allow read: if canReadFinance(tenantId);
        allow write: if false;
      }
      match /financeCostCenters/{id} {
        allow read: if canReadFinance(tenantId);
        allow write: if false;
      }
      match /financeCostAllocationRules/{id} {
        allow read: if canReadFinance(tenantId);
        allow write: if false;
      }
      match /financeCostAllocationRuns/{id} {
        allow read: if canReadFinance(tenantId);
        allow write: if false;
      }
      match /financeBudgets/{id} {
        allow read: if canReadFinance(tenantId);
        allow write: if false;
      }
      match /financeBudgetCommitments/{id} {
        allow read: if canReadFinance(tenantId);
        allow write: if false;
      }
      match /financeFixedAssets/{id} {
        allow read: if canReadFinance(tenantId);
        allow write: if false;
      }
      match /financeDepreciationRuns/{id} {
        allow read: if canReadFinance(tenantId);
        allow write: if false;
      }
      match /financeCloses/{id} {
        allow read: if canReadFinance(tenantId);
        allow write: if false;
      }
      match /financeStatementSnapshots/{id} {
        allow read: if canReadFinance(tenantId);
        allow write: if false;
      }
      match /financeTaxCodes/{id} {
        allow read: if canReadFinance(tenantId);
        allow write: if false;
      }
      match /financeTaxLedger/{id} {
        allow read: if canReadFinance(tenantId);
        allow write: if false;
      }
      match /financeTaxRemittances/{id} {
        allow read: if canReadFinance(tenantId);
        allow write: if false;
      }
      match /financeTaxSummarySnapshots/{id} {
        allow read: if canReadFinance(tenantId);
        allow write: if false;
      }
      match /financeIntelligenceSnapshots/{id} {
        allow read: if canReadFinance(tenantId);
        allow write: if false;
      }

      match /accounts/{id} {
        allow read: if canReadFinance(tenantId);
        allow write: if false;
      }
      match /accountingPeriods/{id} {
        allow read: if canReadFinance(tenantId);
        allow write: if false;
      }
      match /journalEntries/{id} {
        allow read: if canReadFinance(tenantId);
        allow write: if false;
      }
      match /ledgerEntries/{id} {
        allow read: if canReadFinance(tenantId);
        allow write: if false;
      }
      match /patientInvoices/{id} {
        allow read: if canReadFinance(tenantId);
        allow write: if false;
      }
      match /invoices/{id} {
        allow read: if canReadFinance(tenantId);
        allow write: if false;
      }
      match /claims/{id} {
        allow read: if canReadFinance(tenantId);
        allow write: if false;
      }

      match /scmOperationalSnapshots/{id} {
        allow read: if canReadScm(tenantId) || canReadFinance(tenantId);
        allow write: if false;
      }

      match /scmConsignmentAgreements/{id} {
        allow read: if canReadScm(tenantId) || canReadFinance(tenantId);
        allow write: if false;
      }
      match /scmConsignmentLots/{id} {
        allow read: if canReadScm(tenantId);
        allow write: if false;
      }
      match /scmConsignmentUsages/{id} {
        allow read: if canReadScm(tenantId) || canReadFinance(tenantId);
        allow write: if false;
      }
      match /scmConsignmentIdentities/{id} {
        allow read: if canReadScm(tenantId);
        allow write: if false;
      }

      match /scmColdChainObservations/{id} {
        allow read: if canReadScm(tenantId);
        allow write: if false;
      }
      match /scmColdChainExcursions/{id} {
        allow read: if canReadScm(tenantId);
        allow write: if false;
      }
      match /scmControlledCustody/{id} {
        allow read: if canReadScm(tenantId) || canReadAudit(tenantId);
        allow write: if false;
      }

      match /scmRecalls/{id} {
        allow read: if canReadScm(tenantId);
        allow write: if false;
      }
      // Recall exposures contain patient identifiers and are only exposed
      // through authenticated server APIs, never raw Firestore client reads.
      match /scmRecallExposures/{id} {
        allow read, write: if false;
      }
      match /scmInventoryDispositions/{id} {
        allow read: if canReadScm(tenantId) || canReadFinance(tenantId);
        allow write: if false;
      }

      match /scmReplenishmentPolicies/{id} {
        allow read: if canReadScm(tenantId);
        allow write: if false;
      }
      match /scmReplenishmentPlans/{id} {
        allow read: if canReadScm(tenantId) || canReadFinance(tenantId);
        allow write: if false;
      }
      match /scmReplenishmentOrders/{id} {
        allow read: if canReadScm(tenantId);
        allow write: if false;
      }

      match /scmSupplierQualificationReviews/{id} {
        allow read: if canReadScm(tenantId);
        allow write: if false;
      }
      match /scmRfqs/{id} {
        allow read: if canReadScm(tenantId);
        allow write: if false;
      }
      match /scmSupplierQuotations/{id} {
        allow read: if canReadScm(tenantId);
        allow write: if false;
      }
      match /scmSupplierContracts/{id} {
        allow read: if canReadScm(tenantId) || canReadFinance(tenantId);
        allow write: if false;
      }

      match /scmCycleCounts/{id} {
        allow read: if canReadScm(tenantId);
        allow write: if false;
      }
      match /scmStockAdjustments/{id} {
        allow read: if canReadScm(tenantId) || canReadFinance(tenantId);
        allow write: if false;
      }
      match /scmInventoryPeriodCloses/{id} {
        allow read: if canReadScm(tenantId) || canReadFinance(tenantId);
        allow write: if false;
      }

      match /scmSupplierInvoices/{id} {
        allow read: if canReadFinance(tenantId);
        allow write: if false;
      }
      match /scmSupplierInvoiceMatches/{id} {
        allow read: if canReadFinance(tenantId);
        allow write: if false;
      }
      match /scmPaymentAuthorizations/{id} {
        allow read: if canReadFinance(tenantId);
        allow write: if false;
      }
      match /scmSupplierPayments/{id} {
        allow read: if canReadFinance(tenantId);
        allow write: if false;
      }
      match /scmEvents/{id} {
        allow read: if canReadScm(tenantId) || canReadAudit(tenantId);
        allow write: if false;
      }

      match /billingMismatches/{id} {
        allow read: if canReadFinance(tenantId);
        allow write: if false;
      }

      match /encounterCharges/{id} {
        allow read: if canReadFinance(tenantId);
        allow write: if false;
      }
      // Final OPD billing reconciliation is an immutable server-side
      // close-control artifact. Clients consume encounter clearance through
      // governed APIs/read models, never raw reconciliation documents.
      match /opdBillingReconciliations/{id} {
        allow read, write: if false;
      }
      match /arOpenItems/{id} {
        allow read: if canReadFinance(tenantId);
        allow write: if false;
      }
      match /paymentTransactions/{id} {
        allow read: if canReadFinance(tenantId);
        allow write: if false;
      }

      // Facilities / biomedical authoritative read models.
      match /resources/{id} {
        allow read: if canReadFacilities(tenantId) || canReadAudit(tenantId);
        allow write: if false;
      }
      match /rooms/{id} {
        allow read: if canReadFacilities(tenantId) || canReadAudit(tenantId);
        allow write: if false;
      }
      match /resourceReservations/{id} {
        allow read: if canReadFacilities(tenantId) || canReadAudit(tenantId);
        allow write: if false;
      }
      match /maintenanceWorkOrders/{id} {
        allow read: if canReadFacilities(tenantId) || canReadAudit(tenantId);
        allow write: if false;
      }
      match /calibrationRecords/{id} {
        allow read: if canReadFacilities(tenantId) || canReadAudit(tenantId);
        allow write: if false;
      }
      match /resourceIdentities/{id} {
        allow read, write: if false;
      }
      match /roomIdentities/{id} {
        allow read, write: if false;
      }
      match /bedIdentities/{id} {
        allow read, write: if false;
      }

      // Workforce/resource read models.
      match /employees/{id} {
        allow read: if canReadAudit(tenantId);
        allow write: if false;
      }
      match /employeeAssignments/{id} {
        allow read: if canReadAudit(tenantId);
        allow write: if false;
      }
      match /clinicalCredentials/{id} {
        allow read: if canReadAudit(tenantId);
        allow write: if false;
      }
      match /clinicalPrivileges/{id} {
        allow read: if canReadAudit(tenantId);
        allow write: if false;
      }
      match /credentialIdentities/{id} {
        allow read, write: if false;
      }
      match /clinicalPrivilegeSlots/{id} {
        allow read, write: if false;
      }
      match /rosterAssignments/{id} {
        allow read: if canReadAudit(tenantId);
        allow write: if false;
      }
      match /compensationProfiles/{id} {
        allow read: if canReadHcm(tenantId) || canReadFinance(tenantId);
        allow write: if false;
      }
      match /compensationSlots/{id} {
        allow read: if canReadHcm(tenantId) || canReadFinance(tenantId);
        allow write: if false;
      }
      match /payrollPeriods/{id} {
        allow read: if canReadHcm(tenantId) || canReadFinance(tenantId);
        allow write: if false;
      }
      match /payrollEmployeeSlots/{id} {
        allow read: if canReadHcm(tenantId) || canReadFinance(tenantId);
        allow write: if false;
      }
      match /payrollPayslips/{id} {
        allow read: if canReadHcm(tenantId) || canReadFinance(tenantId);
        allow write: if false;
      }
      match /payrollCalendars/{id} {
        allow read, write: if false;
      }
      match /payrollAttendanceLocks/{id} {
        allow read, write: if false;
      }
      match /payrollStatutoryLiabilities/{id} {
        allow read: if canReadHcm(tenantId) || canReadFinance(tenantId);
        allow write: if false;
      }
      match /payrollComplianceSnapshots/{id} {
        allow read: if canReadHcm(tenantId) || canReadFinance(tenantId) || canReadAudit(tenantId);
        allow write: if false;
      }
      match /hcmIntelligenceSnapshots/{id} {
        allow read: if canReadHcm(tenantId) || canReadAudit(tenantId);
        allow write: if false;
      }
      match /leaveBalances/{id} {
        allow read: if canReadHcm(tenantId);
        allow write: if false;
      }
      match /leaveCalendars/{id} {
        allow read: if canReadHcm(tenantId);
        allow write: if false;
      }
      match /attendanceOpenSlots/{id} {
        allow read, write: if false;
      }
      match /attendanceCorrections/{id} {
        allow read: if canReadHcm(tenantId) || canReadAudit(tenantId);
        allow write: if false;
      }
      match /rosterTimelines/{id} {
        allow read, write: if false;
      }
      match /rosterSwaps/{id} {
        allow read, write: if false;
      }
      match /attendanceRecords/{id} {
        allow read: if canReadAudit(tenantId);
        allow write: if false;
      }

      // Security, eventing and configuration stores are server-only.
      match /audit_logs/{id} {
        allow read: if canReadAudit(tenantId);
        allow write: if false;
      }
      match /financialAuditLogs/{id} {
        allow read: if canReadAudit(tenantId);
        allow write: if false;
      }
      match /events/{id} {
        allow read, write: if false;
      }
      match /outbox/{id} {
        allow read, write: if false;
      }
      match /idempotency/{id} {
        allow read, write: if false;
      }
      // AI-generated drafts contain PHI/provenance and remain server-only until accepted
      // through an authorized clinical command.
      match /aiDrafts/{id} {
        allow read, write: if false;
      }
      match /financialIdempotency/{id} {
        allow read, write: if false;
      }
      match /config/{id} {
        allow read, write: if false;
      }
      match /notificationRules/{id} {
        allow read, write: if false;
      }
      match /sso_config/{id} {
        allow read, write: if false;
      }

      // Any tenant collection not explicitly declared above is denied.
      match /{other=**} {
        allow read, write: if false;
      }
    }
  }
}
